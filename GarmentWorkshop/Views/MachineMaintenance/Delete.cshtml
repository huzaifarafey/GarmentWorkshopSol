@model GarmentWorkshop.Models.MachineMaintenance

@{
    ViewData["Title"] = "Delete Maintenance Record";
}

<h2>Delete Maintenance Record</h2>

<p>Are you sure you want to delete this record?</p>

<dl class="row">
    <dt class="col-sm-2">Machine</dt>
    <dd class="col-sm-10">@Model.Machine.Name</dd>

    <dt class="col-sm-2">Date</dt>
    <dd class="col-sm-10">@Model.Date.ToString("dd-MMM-yyyy")</dd>

    <dt class="col-sm-2">Amount</dt>
    <dd class="col-sm-10">₹@Model.Amount</dd>

    <dt class="col-sm-2">Note</dt>
    <dd class="col-sm-10">@Model.Note</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>