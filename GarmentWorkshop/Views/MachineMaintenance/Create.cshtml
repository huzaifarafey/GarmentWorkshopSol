@model GarmentWorkshop.Models.MachineMaintenance

@{
    ViewData["Title"] = "Add Maintenance Record";
}

<h2>Add Maintenance Record</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">Machine</label>
        <select asp-for="MachineId" class="form-control" asp-items="ViewBag.MachineId">
            <option value="">-- Select Machine --</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Date</label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Amount (₹)</label>
        <input asp-for="Amount" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Note (optional)</label>
        <input asp-for="Note" class="form-control" placeholder="e.g. Needle repair, Service" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>