@model IEnumerable<GarmentWorkshop.Models.MachineMaintenance>

@{
    ViewData["Title"] = "Machine Maintenance";
}

<div class="gw-page-header">
    <div>
        <h2>Machine Maintenance</h2>
        <p class="gw-page-subtitle">Track repair and servicing costs across all machines.</p>
    </div>
    <div class="gw-page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Maintenance Record</a>
    </div>
</div>

<div class="gw-card">
    <div class="gw-table-wrap">
        <table class="table table-striped gw-datatable">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Machine</th>
                    <th>Amount</th>
                    <th>Note</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mm in Model)
                {
                    <tr>
                        <td>@mm.Date.ToString("dd-MMM-yyyy")</td>
                        <td>@mm.Machine.Name</td>
                        <td>₹@mm.Amount</td>
                        <td>@mm.Note</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@mm.Id" class="btn btn-sm btn-icon btn-secondary" data-bs-toggle="tooltip" data-bs-placement="top" title="Edit"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@mm.Id" class="btn btn-sm btn-icon btn-danger" data-bs-toggle="tooltip" data-bs-placement="top" title="Delete"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
