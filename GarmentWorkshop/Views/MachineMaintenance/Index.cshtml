@model IEnumerable<GarmentWorkshop.Models.MachineMaintenance>

@{
    ViewData["Title"] = "Machine Maintenance";
}

<h2>Machine Maintenance</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add Maintenance Record</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Machine</th>
            <th>Amount</th>
            <th>Note</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var mm in Model)
        {
            <tr>
                <td>@mm.Date.ToString("dd-MMM-yyyy")</td>
                <td>@mm.Machine.Name</td>
                <td>₹@mm.Amount</td>
                <td>@mm.Note</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@mm.Id" class="btn btn-sm btn-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@mm.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>