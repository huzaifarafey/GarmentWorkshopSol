@model IEnumerable<GarmentWorkshop.Models.Garment>

@{
    ViewData["Title"] = "Garments";
}

<h2>Garments</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add Garment</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var garment in Model)
        {
            <tr>
                <td>@garment.Name</td>
                <td>@garment.Category</td>
                <td>@garment.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@garment.Id" class="btn btn-sm btn-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@garment.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>