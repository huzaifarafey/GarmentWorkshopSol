@model GarmentWorkshop.Models.Garment

@{
    ViewData["Title"] = "Delete Garment";
}

<div class="gw-page-header">
    <div>
        <h2>Delete Garment</h2>
        <p class="gw-page-subtitle">This action cannot be undone.</p>
    </div>
    <div class="gw-page-actions">
        <a asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-arrow-left"></i> Back to List</a>
    </div>
</div>

<div class="gw-card gw-form-card">
    <div class="gw-form-card-head">
        <span class="gw-form-card-icon" style="background:var(--gw-danger-bg); color:var(--gw-danger);"><i class="bi bi-exclamation-triangle"></i></span>
        <div>
            <strong>Delete Garment</strong>
            <span>Review the details before confirming</span>
        </div>
    </div>
    <div class="gw-form-body">
        <div class="gw-delete-alert">
            <i class="bi bi-exclamation-octagon"></i>
            <div>Are you sure you want to delete this garment? This action cannot be undone.</div>
        </div>

        <dl class="row gw-detail-list">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9"><span class="badge @(Model.Status == GarmentWorkshop.Models.GarmentStatus.Active ? "gw-badge-success" : "gw-badge-neutral")">@Model.Status</span></dd>
        </dl>

        <form asp-action="Delete" method="post" class="gw-form-actions">
            <input type="hidden" asp-for="Id" />
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-x-lg"></i> Cancel</a>
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
        </form>
    </div>
</div>
