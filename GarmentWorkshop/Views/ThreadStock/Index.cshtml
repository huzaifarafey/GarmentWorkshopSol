@model IEnumerable<GarmentWorkshop.Models.ThreadStock>

@{
    ViewData["Title"] = "Thread Stock";
}

<h2>Thread Stock</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add Thread Type</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Color/Type</th>
            <th>Current Quantity</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var stock in Model)
        {
            <tr>
                <td>@stock.ColorOrType</td>
                <td>@stock.CurrentQuantity</td>
                <td>
                    <a asp-action="Delete" asp-route-id="@stock.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>