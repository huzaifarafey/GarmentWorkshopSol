@model IEnumerable<GarmentWorkshop.Models.ThreadStock>

@{
    ViewData["Title"] = "Thread Stock";
}

<div class="gw-page-header">
    <div>
        <h2>Thread Stock</h2>
        <p class="gw-page-subtitle">Current stock levels for each thread color and type.</p>
    </div>
    <div class="gw-page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Thread Type</a>
    </div>
</div>

<div class="gw-card">
    <div class="gw-table-wrap">
        <table class="table table-striped gw-datatable">
            <thead>
                <tr>
                    <th>Color/Type</th>
                    <th>Current Quantity</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var stock in Model)
                {
                    <tr>
                        <td>@stock.ColorOrType</td>
                        <td>@stock.CurrentQuantity</td>
                        <td>
                            <a asp-action="Delete" asp-route-id="@stock.Id" class="btn btn-sm btn-icon btn-danger" data-bs-toggle="tooltip" data-bs-placement="top" title="Delete"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
