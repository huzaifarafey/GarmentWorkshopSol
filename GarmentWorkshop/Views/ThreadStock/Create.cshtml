@model GarmentWorkshop.Models.ThreadStock

@{
    ViewData["Title"] = "Add Thread Type";
}

<div class="gw-page-header">
    <div>
        <h2>Add Thread Type</h2>
        <p class="gw-page-subtitle">Register a new thread color or type to track its stock.</p>
    </div>
    <div class="gw-page-actions">
        <a asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-arrow-left"></i> Back to List</a>
    </div>
</div>

<div class="gw-card gw-form-card">
    <div class="gw-form-card-head">
        <span class="gw-form-card-icon"><i class="bi bi-slash-circle"></i></span>
        <div>
            <strong>Thread Type Details</strong>
            <span>Track a new thread color or type</span>
        </div>
    </div>
    <form asp-action="Create" method="post" class="gw-form-body">
        <div class="row g-3">
            <div class="col-md-6 gw-field">
                <label class="form-label">Color / Type</label>
                <div class="gw-field-icon">
                    <i class="bi bi-tag"></i>
                    <input asp-for="ColorOrType" class="form-control" placeholder="e.g. White, Black 40s" />
                </div>
                <span asp-validation-for="ColorOrType" class="text-danger"></span>
            </div>
        </div>

        <div class="gw-form-actions">
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-x-lg"></i> Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save</button>
        </div>
    </form>
</div>
