@model GarmentWorkshop.Models.Party

@{
    ViewData["Title"] = "Delete Party";
}

<h2>Delete Party</h2>

<p>Are you sure you want to delete this party?</p>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>

    <dt class="col-sm-2">Contact Person</dt>
    <dd class="col-sm-10">@Model.ContactPerson</dd>

    <dt class="col-sm-2">Mobile</dt>
    <dd class="col-sm-10">@Model.Mobile</dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Status</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>