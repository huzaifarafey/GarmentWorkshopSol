@model IEnumerable<GarmentWorkshop.Models.Party>

@{
    ViewData["Title"] = "Parties";
}

<h2>Parties</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add Party</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Contact Person</th>
            <th>Mobile</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var party in Model)
        {
            <tr>
                <td>@party.Name</td>
                <td>@party.ContactPerson</td>
                <td>@party.Mobile</td>
                <td>@party.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@party.Id" class="btn btn-sm btn-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@party.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>