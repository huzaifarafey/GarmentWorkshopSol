@model GarmentWorkshop.Models.Party

@{
    ViewData["Title"] = "Add Party";
}

<div class="gw-page-header">
    <div>
        <h2>Add Party</h2>
        <p class="gw-page-subtitle">Register a new party (customer) you work with.</p>
    </div>
    <div class="gw-page-actions">
        <a asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-arrow-left"></i> Back to List</a>
    </div>
</div>

<div class="gw-card gw-form-card">
    <div class="gw-form-card-head">
        <span class="gw-form-card-icon"><i class="bi bi-briefcase"></i></span>
        <div>
            <strong>Party Details</strong>
            <span>Basic information about the party</span>
        </div>
    </div>
    <form asp-action="Create" method="post" class="gw-form-body">
        <div class="row g-3">
            <div class="col-md-6 gw-field">
                <label class="form-label">Party Name</label>
                <div class="gw-field-icon">
                    <i class="bi bi-briefcase"></i>
                    <input asp-for="Name" class="form-control" />
                </div>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-md-6 gw-field">
                <label class="form-label">Contact Person</label>
                <div class="gw-field-icon">
                    <i class="bi bi-person-badge"></i>
                    <input asp-for="ContactPerson" class="form-control" />
                </div>
                <span asp-validation-for="ContactPerson" class="text-danger"></span>
            </div>

            <div class="col-md-6 gw-field">
                <label class="form-label">Mobile</label>
                <div class="gw-field-icon">
                    <i class="bi bi-telephone"></i>
                    <input asp-for="Mobile" class="form-control" />
                </div>
                <span asp-validation-for="Mobile" class="text-danger"></span>
            </div>

            <div class="col-md-6 gw-field">
                <label class="form-label">Status</label>
                <div class="gw-field-icon">
                    <i class="bi bi-toggle2-on"></i>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<GarmentWorkshop.Models.PartyStatus>()"></select>
                </div>
            </div>
        </div>

        <div class="gw-form-actions">
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-x-lg"></i> Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save</button>
        </div>
    </form>
</div>
