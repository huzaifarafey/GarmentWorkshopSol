@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool IsActive(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GarmentWorkshop</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.11/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GarmentWorkshop.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="gw-app">
        <div class="gw-sidebar-backdrop" id="gwSidebarBackdrop"></div>

        <aside class="gw-sidebar" id="gwSidebar">
            <div class="gw-sidebar-brand">
                <span class="gw-logo-mark"><i class="bi bi-scissors"></i></span>
                <span>GarmentWorkshop</span>
            </div>
            <ul class="gw-sidebar-nav">
                <li class="nav-item">
                    <a class="nav-link @(IsActive("Dashboard") ? "active" : "")" asp-area="" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2 gw-nav-ico"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsActive("Worker") ? "active" : "")" asp-area="" asp-controller="Worker" asp-action="Index">
                        <i class="bi bi-people gw-nav-ico"></i> Workers
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsActive("Party") ? "active" : "")" asp-area="" asp-controller="Party" asp-action="Index">
                        <i class="bi bi-briefcase gw-nav-ico"></i> Parties
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsActive("Garment") ? "active" : "")" asp-area="" asp-controller="Garment" asp-action="Index">
                        <i class="bi bi-bag gw-nav-ico"></i> Garments
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsActive("WorkerRate") ? "active" : "")" asp-area="" asp-controller="WorkerRate" asp-action="Index">
                        <i class="bi bi-cash-coin gw-nav-ico"></i> Worker Rate
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsActive("WorkOrder") ? "active" : "")" asp-area="" asp-controller="WorkOrder" asp-action="Index">
                        <i class="bi bi-clipboard-check gw-nav-ico"></i> Work Order
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsActive("Production") ? "active" : "")" asp-area="" asp-controller="Production" asp-action="Index">
                        <i class="bi bi-graph-up gw-nav-ico"></i> Production
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsActive("Machine") ? "active" : "")" asp-area="" asp-controller="Machine" asp-action="Index">
                        <i class="bi bi-gear gw-nav-ico"></i> Machines
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsActive("MachineMaintenance") ? "active" : "")" asp-area="" asp-controller="MachineMaintenance" asp-action="Index">
                        <i class="bi bi-tools gw-nav-ico"></i> Maintenance
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsActive("DailyEntry") ? "active" : "")" asp-area="" asp-controller="DailyEntry" asp-action="Index">
                        <i class="bi bi-calendar2-check gw-nav-ico"></i> Daily Entry
                    </a>
                </li>
            </ul>
            <div class="gw-sidebar-foot">
                &copy; 2026 GarmentWorkshop
            </div>
        </aside>

        <div class="gw-main">
            <header class="gw-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="gw-sidebar-toggle" type="button" id="gwSidebarToggle" aria-label="Toggle navigation">
                        <i class="bi bi-list"></i>
                    </button>
                    <span class="gw-topbar-title">@ViewData["Title"]</span>
                </div>
                <div class="gw-topbar-right">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-muted">
                        <i class="bi bi-shield-check"></i> Privacy
                    </a>
                </div>
            </header>

            <main role="main" class="gw-content">
                @RenderBody()
            </main>

            <footer class="gw-footer">
                &copy; 2026 - GarmentWorkshop
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net@1.13.11/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.11/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
