@model GarmentWorkshop.Models.WorkerRate

@{
    ViewData["Title"] = "Delete Worker Rate";
}

<h2>Delete Worker Rate</h2>

<p>Are you sure you want to delete this rate?</p>

<dl class="row">
    <dt class="col-sm-2">Worker</dt>
    <dd class="col-sm-10">@Model.Worker.Name</dd>

    <dt class="col-sm-2">Garment</dt>
    <dd class="col-sm-10">@Model.Garment.Name</dd>

    <dt class="col-sm-2">Rate/Piece</dt>
    <dd class="col-sm-10">₹@Model.RatePerPiece</dd>

    <dt class="col-sm-2">Effective From</dt>
    <dd class="col-sm-10">@Model.EffectiveFrom.ToString("dd-MMM-yyyy")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>