@model GarmentWorkshop.ViewModels.DailyEntryViewModel

@{
    ViewData["Title"] = "Daily Entry";
}

<div class="gw-page-header">
    <div>
        <h2>Daily Entry</h2>
        <p class="gw-page-subtitle">Log today's production, expenses, maintenance and thread usage in one place.</p>
    </div>
</div>

@if (ViewBag.Message != null)
{
    <div class="alert alert-info">@ViewBag.Message</div>
}

<div class="gw-card">
    <ul class="nav nav-tabs" id="entryTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(ViewBag.ActiveTab == "production" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#production" type="button"><i class="bi bi-graph-up"></i> Production</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(ViewBag.ActiveTab == "expense" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#expense" type="button"><i class="bi bi-receipt"></i> Expense</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(ViewBag.ActiveTab == "maintenance" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#maintenance" type="button"><i class="bi bi-tools"></i> Maintenance</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(ViewBag.ActiveTab == "thread" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#thread" type="button"><i class="bi bi-slash-circle"></i> Thread</button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 p-3">

        <!-- Production Tab -->
        <div class="tab-pane fade @(ViewBag.ActiveTab == "production" ? "show active" : "")" id="production">
            <form asp-action="AddProduction" method="post">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Worker</label>
                        <div class="gw-field-icon">
                            <i class="bi bi-person"></i>
                            <select name="WorkerId" class="form-select" asp-items="Model.Workers">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Work Order</label>
                        <div class="gw-field-icon">
                            <i class="bi bi-clipboard-check"></i>
                            <select name="WorkOrderId" class="form-select" asp-items="Model.WorkOrders">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Date</label>
                        <div class="gw-field-icon">
                            <i class="bi bi-calendar3"></i>
                            <input name="Date" type="date" class="form-control" value="@Model.ProductionEntry.Date.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Pieces</label>
                        <div class="gw-field-icon">
                            <i class="bi bi-box-seam"></i>
                            <input name="PiecesProduced" type="number" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check2"></i> Save</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Expense Tab -->
        <div class="tab-pane fade @(ViewBag.ActiveTab == "expense" ? "show active" : "")" id="expense">
            <form asp-action="AddExpense" method="post">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Category</label>
                        <div class="gw-field-icon">
                            <i class="bi bi-tag"></i>
                            <select name="ExpenseCategoryId" class="form-select" asp-items="Model.ExpenseCategories">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Date</label>
                        <div class="gw-field-icon">
                            <i class="bi bi-calendar3"></i>
                            <input name="Date" type="date" class="form-control" value="@Model.ExpenseEntry.Date.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Amount (₹)</label>
                        <div class="gw-field-icon">
                            <i class="bi bi-currency-rupee"></i>
                            <input name="Amount" type="number" step="0.01" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Note (optional)</label>
                        <div class="gw-field-icon">
                            <i class="bi bi-card-text"></i>
                            <input name="Note" class="form-control" placeholder="e.g. Material pickup" />
                        </div>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check2"></i> Save</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Maintenance Tab -->
        <div class="tab-pane fade @(ViewBag.ActiveTab == "maintenance" ? "show active" : "")" id="maintenance">
            <form asp-action="AddMaintenance" method="post">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Machine</label>
                        <div class="gw-field-icon">
                            <i class="bi bi-gear"></i>
                            <select name="MachineId" class="form-select" asp-items="Model.Machines">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Date</label>
                        <div class="gw-field-icon">
                            <i class="bi bi-calendar3"></i>
                            <input name="Date" type="date" class="form-control" value="@Model.MaintenanceEntry.Date.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Amount (₹)</label>
                        <div class="gw-field-icon">
                            <i class="bi bi-currency-rupee"></i>
                            <input name="Amount" type="number" step="0.01" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Note (optional)</label>
                        <div class="gw-field-icon">
                            <i class="bi bi-card-text"></i>
                            <input name="Note" class="form-control" placeholder="e.g. Needle repair" />
                        </div>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check2"></i> Save</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Thread Tab -->
        <div class="tab-pane fade @(ViewBag.ActiveTab == "thread" ? "show active" : "")" id="thread">
            <form asp-action="AddThread" method="post">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Thread Type</label>
                        <div class="gw-field-icon">
                            <i class="bi bi-slash-circle"></i>
                            <select name="ThreadStockId" class="form-select" asp-items="Model.ThreadStocks">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Date</label>
                        <div class="gw-field-icon">
                            <i class="bi bi-calendar3"></i>
                            <input name="Date" type="date" class="form-control" value="@Model.ThreadEntry.Date.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Type</label>
                        <div class="gw-field-icon">
                            <i class="bi bi-tag"></i>
                            <select name="Type" class="form-select">
                                <option value="Purchase">Purchase</option>
                                <option value="Consumption">Consumption</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Quantity</label>
                        <div class="gw-field-icon">
                            <i class="bi bi-box-seam"></i>
                            <input name="Quantity" type="number" step="0.01" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check2"></i> Save</button>
                    </div>
                </div>
            </form>
        </div>

    </div>
</div>

<div class="gw-card mb-0">
    <div class="gw-card-header">
        <h4><i class="bi bi-list-check me-1 text-muted"></i> Today's Entries</h4>
    </div>

    @if (!Model.TodayEntries.Any())
    {
        <div class="gw-empty-state">No entries yet today.</div>
    }
    else
    {
        <div class="gw-table-wrap">
            <table class="table table-sm table-striped gw-datatable">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Description</th>
                        <th>Value</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.TodayEntries)
                    {
                        <tr>
                            <td><span class="badge gw-badge-info">@entry.Type</span></td>
                            <td>@entry.Description</td>
                            <td>@entry.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
