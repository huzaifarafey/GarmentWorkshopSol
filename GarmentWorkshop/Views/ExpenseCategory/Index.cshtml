@model IEnumerable<GarmentWorkshop.Models.ExpenseCategory>

@{
    ViewData["Title"] = "Expense Categories";
}

<div class="gw-page-header">
    <div>
        <h2>Expense Categories</h2>
        <p class="gw-page-subtitle">Manage the categories used to classify workshop expenses.</p>
    </div>
    <div class="gw-page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Category</a>
    </div>
</div>

<div class="gw-card">
    <div class="gw-table-wrap">
        <table class="table table-striped gw-datatable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Model)
                {
                    <tr>
                        <td>@cat.Name</td>
                        <td>
                            <a asp-action="Delete" asp-route-id="@cat.Id" class="btn btn-sm btn-icon btn-danger" data-bs-toggle="tooltip" data-bs-placement="top" title="Delete"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
