@model IEnumerable<GarmentWorkshop.Models.ExpenseCategory>

@{
    ViewData["Title"] = "Expense Categories";
}

<h2>Expense Categories</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add Category</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cat in Model)
        {
            <tr>
                <td>@cat.Name</td>
                <td>
                    <a asp-action="Delete" asp-route-id="@cat.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>