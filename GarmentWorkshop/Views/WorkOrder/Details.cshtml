@model GarmentWorkshop.Models.WorkOrder

@{
    ViewData["Title"] = "Work Order Details";
}

<h2>Work Order Details</h2>

<dl class="row">
    <dt class="col-sm-3">Party</dt>
    <dd class="col-sm-9">@Model.Party.Name</dd>

    <dt class="col-sm-3">Garment</dt>
    <dd class="col-sm-9">@Model.Garment.Name</dd>

    <dt class="col-sm-3">Total Pieces</dt>
    <dd class="col-sm-9">@Model.TotalPieces</dd>

    <dt class="col-sm-3">Party Rate</dt>
    <dd class="col-sm-9">₹@Model.PartyRatePerPiece / piece</dd>

    <dt class="col-sm-3">Start Date</dt>
    <dd class="col-sm-9">@Model.StartDate.ToString("dd-MMM-yyyy")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Completed Pieces</dt>
    <dd class="col-sm-9">@ViewBag.CompletedPieces</dd>

    <dt class="col-sm-3">Pending Pieces</dt>
    <dd class="col-sm-9">@ViewBag.PendingPieces</dd>

    <dt class="col-sm-3">Revenue So Far</dt>
    <dd class="col-sm-9">₹@((int)ViewBag.CompletedPieces * Model.PartyRatePerPiece)</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Back to List</a>