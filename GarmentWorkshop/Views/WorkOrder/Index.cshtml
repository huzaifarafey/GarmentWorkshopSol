@model IEnumerable<GarmentWorkshop.Models.WorkOrder>

@{
    ViewData["Title"] = "Work Orders";
}

<h2>Work Orders</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add Work Order</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Party</th>
            <th>Garment</th>
            <th>Total Pieces</th>
            <th>Party Rate</th>
            <th>Start Date</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var wo in Model)
        {
            <tr>
                <td>@wo.Party.Name</td>
                <td>@wo.Garment.Name</td>
                <td>@wo.TotalPieces</td>
                <td>₹@wo.PartyRatePerPiece</td>
                <td>@wo.StartDate.ToString("dd-MMM-yyyy")</td>
                <td>@wo.Status</td>
                <td>
                    <a asp-action="Details" asp-route-id="@wo.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@wo.Id" class="btn btn-sm btn-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@wo.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>