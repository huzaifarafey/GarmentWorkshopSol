@model GarmentWorkshop.Models.Production

@{
    ViewData["Title"] = "Delete Production";
}

<h2>Delete Production</h2>

<p>Are you sure you want to delete this production record?</p>

<dl class="row">
    <dt class="col-sm-3">Worker</dt>
    <dd class="col-sm-9">@Model.Worker.Name</dd>

    <dt class="col-sm-3">Garment</dt>
    <dd class="col-sm-9">@Model.WorkOrder.Garment.Name</dd>

    <dt class="col-sm-3">Date</dt>
    <dd class="col-sm-9">@Model.Date.ToString("dd-MMM-yyyy")</dd>

    <dt class="col-sm-3">Pieces</dt>
    <dd class="col-sm-9">@Model.PiecesProduced</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>