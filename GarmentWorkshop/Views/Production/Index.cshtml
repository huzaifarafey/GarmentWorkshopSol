@model IEnumerable<GarmentWorkshop.Models.Production>

@{
    ViewData["Title"] = "Daily Production";
}

<h2>Daily Production</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add Production</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Worker</th>
            <th>Party</th>
            <th>Garment</th>
            <th>Pieces</th>
            <th>Earning</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Date.ToString("dd-MMM-yyyy")</td>
                <td>@p.Worker.Name</td>
                <td>@p.WorkOrder.Party.Name</td>
                <td>@p.WorkOrder.Garment.Name</td>
                <td>@p.PiecesProduced</td>
                <td>₹@ViewBag.Earnings[p.Id]</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>