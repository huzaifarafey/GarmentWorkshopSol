@model GarmentWorkshop.Models.Production

@{
    ViewData["Title"] = "Edit Production";
}

<div class="gw-page-header">
    <div>
        <h2>Edit Production</h2>
        <p class="gw-page-subtitle">Update this production record's details.</p>
    </div>
    <div class="gw-page-actions">
        <a asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-arrow-left"></i> Back to List</a>
    </div>
</div>

<div class="gw-card gw-form-card">
    <div class="gw-form-card-head">
        <span class="gw-form-card-icon"><i class="bi bi-graph-up"></i></span>
        <div>
            <strong>Production Details</strong>
            <span>Update this production record</span>
        </div>
    </div>
    <form asp-action="Edit" method="post" class="gw-form-body">
        <input type="hidden" asp-for="Id" />

        <div class="row g-3">
            <div class="col-md-6 gw-field">
                <label class="form-label">Worker</label>
                <div class="gw-field-icon">
                    <i class="bi bi-person"></i>
                    <select asp-for="WorkerId" class="form-select" asp-items="ViewBag.WorkerId"></select>
                </div>
            </div>

            <div class="col-md-6 gw-field">
                <label class="form-label">Work Order</label>
                <div class="gw-field-icon">
                    <i class="bi bi-clipboard-check"></i>
                    <select asp-for="WorkOrderId" class="form-select" asp-items="ViewBag.WorkOrderId"></select>
                </div>
            </div>

            <div class="col-md-6 gw-field">
                <label class="form-label">Date</label>
                <div class="gw-field-icon">
                    <i class="bi bi-calendar3"></i>
                    <input asp-for="Date" type="date" class="form-control" />
                </div>
            </div>

            <div class="col-md-6 gw-field">
                <label class="form-label">Pieces Produced</label>
                <div class="gw-field-icon">
                    <i class="bi bi-box-seam"></i>
                    <input asp-for="PiecesProduced" class="form-control" />
                </div>
            </div>
        </div>

        <div class="gw-form-actions">
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-x-lg"></i> Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save</button>
        </div>
    </form>
</div>
