@model GarmentWorkshop.Models.Production

@{
    ViewData["Title"] = "Add Production";
}

<h2>Add Production</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <div asp-validation-summary="All"></div>
    </div>
}

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">Worker</label>
        <select asp-for="WorkerId" class="form-control" asp-items="ViewBag.WorkerId">
            <option value="">-- Select Worker --</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Work Order</label>
        <select asp-for="WorkOrderId" class="form-control" asp-items="ViewBag.WorkOrderId">
            <option value="">-- Select Work Order --</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Date</label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Pieces Produced</label>
        <input asp-for="PiecesProduced" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>