@model GarmentWorkshop.Models.Machine

@{
    ViewData["Title"] = "Edit Machine";
}

<div class="gw-page-header">
    <div>
        <h2>Edit Machine</h2>
        <p class="gw-page-subtitle">Update details for this machine.</p>
    </div>
    <div class="gw-page-actions">
        <a asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-arrow-left"></i> Back to List</a>
    </div>
</div>

<div class="gw-card gw-form-card">
    <div class="gw-form-card-head">
        <span class="gw-form-card-icon"><i class="bi bi-gear"></i></span>
        <div>
            <strong>Machine Details</strong>
            <span>Update information about this machine</span>
        </div>
    </div>
    <form asp-action="Edit" method="post" class="gw-form-body">
        <input type="hidden" asp-for="Id" />

        <div class="row g-3">
            <div class="col-md-6 gw-field">
                <label class="form-label">Name</label>
                <div class="gw-field-icon">
                    <i class="bi bi-tag"></i>
                    <input asp-for="Name" class="form-control" />
                </div>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-md-6 gw-field">
                <label class="form-label">Type</label>
                <div class="gw-field-icon">
                    <i class="bi bi-gear"></i>
                    <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<GarmentWorkshop.Models.MachineType>()"></select>
                </div>
            </div>

            <div class="col-md-6 gw-field">
                <label class="form-label">Status</label>
                <div class="gw-field-icon">
                    <i class="bi bi-toggle2-on"></i>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<GarmentWorkshop.Models.MachineStatus>()"></select>
                </div>
            </div>
        </div>

        <div class="gw-form-actions">
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-x-lg"></i> Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save</button>
        </div>
    </form>
</div>
