@model IEnumerable<GarmentWorkshop.Models.Machine>

@{
    ViewData["Title"] = "Machines";
}

<div class="gw-page-header">
    <div>
        <h2>Machines</h2>
        <p class="gw-page-subtitle">All machines available in your workshop.</p>
    </div>
    <div class="gw-page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Machine</a>
    </div>
</div>

<div class="gw-card">
    <div class="gw-table-wrap">
        <table class="table table-striped gw-datatable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var machine in Model)
                {
                    <tr>
                        <td>@machine.Name</td>
                        <td>@machine.Type</td>
                        <td><span class="badge @(machine.Status == GarmentWorkshop.Models.MachineStatus.Active ? "gw-badge-success" : "gw-badge-neutral")">@machine.Status</span></td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@machine.Id" class="btn btn-sm btn-icon btn-secondary" data-bs-toggle="tooltip" data-bs-placement="top" title="Edit"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@machine.Id" class="btn btn-sm btn-icon btn-danger" data-bs-toggle="tooltip" data-bs-placement="top" title="Delete"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
