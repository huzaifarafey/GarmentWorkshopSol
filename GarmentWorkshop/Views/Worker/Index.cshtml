@model IEnumerable<GarmentWorkshop.Models.Worker>

@{
    ViewData["Title"] = "Workers";
}

<h2>Workers</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add Worker</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var worker in Model)
        {
            <tr>
                <td>@worker.Name</td>
                <td>@worker.Phone</td>
                <td>@worker.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@worker.Id" class="btn btn-sm btn-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@worker.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>