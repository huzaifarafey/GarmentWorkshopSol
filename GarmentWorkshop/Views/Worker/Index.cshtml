@model IEnumerable<GarmentWorkshop.Models.Worker>

@{
    ViewData["Title"] = "Workers";
}

<div class="gw-page-header">
    <div>
        <h2>Workers</h2>
        <p class="gw-page-subtitle">All workers employed in your workshop.</p>
    </div>
    <div class="gw-page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Worker</a>
    </div>
</div>

<div class="gw-card">
    <div class="gw-table-wrap">
        <table class="table table-striped gw-datatable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var worker in Model)
                {
                    <tr>
                        <td>@worker.Name</td>
                        <td>@worker.Phone</td>
                        <td><span class="badge @(worker.Status == GarmentWorkshop.Models.WorkerStatus.Active ? "gw-badge-success" : "gw-badge-neutral")">@worker.Status</span></td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@worker.Id" class="btn btn-sm btn-icon btn-secondary" data-bs-toggle="tooltip" data-bs-placement="top" title="Edit"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@worker.Id" class="btn btn-sm btn-icon btn-danger" data-bs-toggle="tooltip" data-bs-placement="top" title="Delete"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
